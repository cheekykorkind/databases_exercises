<p style="color: green"><%= notice %></p>

<% content_for :title, "Articles" %>

<h1>Articles</h1>

<div id="articles">
  <% @articles.each do |article| %>
    <%= render article %>
    <p>
      <%= link_to "Show this article", project_article_path(@project, article) %>
    </p>
  <% end %>
</div>

<%= link_to "New Article", new_project_article_path(@project) %>
